<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <ApplicationId>org.sloopfm.mobile</ApplicationId>
    <ApplicationTitle>MerthSloop Mobile</ApplicationTitle>
    <MerthSloopVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../../../firmware/src/version.h')), '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+').Value)</MerthSloopVersion>
    <ApplicationVersion>$([System.Text.RegularExpressions.Regex]::Match('$(MerthSloopVersion)', '[0-9]+$').Value)</ApplicationVersion>
    <ApplicationDisplayVersion>$(MerthSloopVersion)</ApplicationDisplayVersion>
    <!-- APKs must launch when installed directly with adb, without IDE fast-deployment files. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Sloop.Core/Sloop.Core.csproj" />
    <ProjectReference Include="../Sloop.Protocol/Sloop.Protocol.csproj" />
    <ProjectReference Include="../Sloop.Simulator/Sloop.Simulator.csproj" />
    <ProjectReference Include="../Sloop.Workstation/Sloop.Workstation.csproj" />
    <ProjectReference Include="../Sloop.Scenes.Android/Sloop.Scenes.Android.csproj" />
  </ItemGroup>
</Project>
